# Telegram API credentials
# Get them at https://my.telegram.org
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here
TG_PHONE=your_phone_number_here

# JWT secret key (change this in production)
PLACEOFPOWER_SECRET_KEY=change-this-to-a-random-string

# Telethon lifecycle limits (seconds)
TG_AUTH_TIMEOUT_SECONDS=60
TG_AUTH_SESSION_TTL_SECONDS=600
TG_DOWNLOAD_TIMEOUT_SECONDS=7200
TG_DISCONNECT_TIMEOUT_SECONDS=30
